      "parameters": {
        "jsCode": "const entry = $json.body?.entry?.[0];\nconst change = entry?.changes?.[0]?.value;\nconst message = change?.messages?.[0];\nconst contact = change?.contacts?.[0];\n\nconst sender = message?.from || null;\nconst text = message?.text?.body || (message?.type === 'text' ? 'Nessun testo' : `[Tipo: ${message?.type || 'sconosciuto'}]`);\nconst name = contact?.profile?.name || contact?.wa_id || 'Utente';\n\nif (!sender) {\n  return [{ json: { skip: true, reason: 'Nessun messaggio valido' } }];\n}\n\nreturn [{\n  json: {\n    sender: sender,\n    text: text,\n    name: name,\n    skip: false\n  }\n}];"
