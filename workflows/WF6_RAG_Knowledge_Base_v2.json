    {
      "parameters": {
        "jsCode": "// === ESTRAI CONTESTO CON GROUNDING ===\nconst results = $json.result || [];\nconst question = $('Estrai Domanda').item.json.question;\nif (!results || results.length === 0) {\n  return [{ json: { grounding_ok: false, context: '', sources: [], question: question, message: 'Nessun contesto pertinente trovato nella Knowledge Base.' } }];\n}\nconst chunks = results.map((r, i) = > {\n  const p = r.payload || {};\n  return { rank: i + 1, score: r.score, text: p.text_content || '', source: p.source_reference || p.chunk_id || 'unknown', type: p.document_type || 'unknown', section: p.section_title || null };\n});\nconst contextText = chunks.map(c = > `[FONTE ${c.rank}] (score: ${c.score.toFixed(3)}, tipo: ${c.type})\\n${c.text}\\n`).join('\\n---\\n');\nreturn [{ json: { grounding_ok: true, context: contextText, sources: chunks.map(c = > ({ rank: c.rank, source: c.source, score: c.score })), question: question, chunk_count: chunks.length } }]; "
      },
