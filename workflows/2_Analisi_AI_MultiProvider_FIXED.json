    {
      "parameters": {
        "jsCode": "let raw = ($json.choices && $json.choices[0] && $json.choices[0].message) ? $json.choices[0].message.content : '';\nraw = String(raw).replace(/```json\\n?/gi,'').replace(/```\\n?/gi,'').trim();\ntry {\n  const parsed = JSON.parse(raw);\n  if (!parsed.sentiment) parsed.sentiment = 'Non determinato';\n  if (!parsed.categorie) parsed.categorie = {};\n  if (!Array.isArray(parsed.azioni_operative)) parsed.azioni_operative = [];\n  if (!Array.isArray(parsed.urgenze)) parsed.urgenze = [];\n  return [{ json: { success: true, report: parsed, provider: $json.model || 'unknown' } }];\n} catch (e) {\n  return [{ json: { success: false, error: e.message, raw: raw.slice(0,500) } }];\n}"
      },
