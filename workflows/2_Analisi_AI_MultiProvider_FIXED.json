      "parameters": {
        "jsCode": "const dataStr = JSON.stringify($json.aggregatedData || [{ source: 'raw-input', content: JSON.stringify($json) }]);\nconst prompt = `Sei un assistente che organizza note personali. NON stai dando consigli finanziari, stai solo categorizzando informazioni gia note.\n\nCompito:\n1. Identifica task pendenti\n2. Categorizza per area (Trading, Lavoro, Personale, Urgenze, Progetti)\n3. Estrai lista azioni operative\n4. Valuta sentiment generale\n\nRispondi SOLO con un oggetto JSON valido con chiavi: sentiment, categorie, azioni_operative, urgenze.\n\nDATI:\n` + dataStr;\n\nconst baseBody = { messages: [{ role: 'user', content: prompt }], temperature: 0.3, stream: false };\n\nreturn [{ json: {\n  bionicBody: JSON.stringify({ ...baseBody, model: 'qwen2.5-coder-14b-instruct' }),\n  qwenBody: JSON.stringify({ ...baseBody, model: $env.QWEN_MODEL || 'auto' }),\n  groqBody: JSON.stringify({ ...baseBody, model: 'openai/gpt-oss-120b' })\n}}];"
      },
