      "parameters": {
        "jsCode": "const aggregatedData = $json.aggregatedData;\nconst prompt =  `Agisci da assistente esecutivo personale. Analizza i dati aggregati forniti...`;\nconst baseBody = { messages: [{ role:  \"user \", content: prompt }], temperature: 0.3, stream: false };\nreturn [{ json: {\n  baseBody,\n  bionicBody: JSON.stringify({ ...baseBody, model:  \"qwen/qwen2.5-vl-7b \" }),\n  groqBody: JSON.stringify({ ...baseBody, model:  \"qwen/qwen3.8-27b \" }),\n  qwenBody: JSON.stringify({ ...baseBody, model:  \"qwen3.6-flash \" })\n}}]; "
