        "jsCode": "const allData = [];\nconst errors = [];\n\ntry {\n  const notesNode = $('Read notes.txt').item.json;\n  \n  // Gestione robusta del contenuto\n  let content = notesNode.data || notesNode.body || notesNode.content || notesNode.text;\n  \n  if (content && typeof content === 'object') {\n    content = JSON.stringify(content);\n  }\n  \n  if (!content || content === '{}') {\n    content = JSON.stringify(notesNode);\n  }\n  \n  if (content && content.trim().length > 0) {\n    allData.push({ \n      source: 'Nextcloud', \n      content: content \n    });\n  } else {\n    errors.push('Nextcloud: file notes_v2.txt vuoto.');\n  }\n  \n} catch (e) {\n  errors.push('Nextcloud: ' + e.message);\n}\n\nreturn [{ \n  json: { \n    aggregatedData: allData, \n    errors: errors, \n    count: allData.length \n  } \n}];"
