      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst chat = item.message?.chat || item.chat;\nconst text = item.message?.text || item.text || '';\nconst messageId = item.message?.message_id || item.message_id;\n\nif (!chat || !chat.id) {\n  return { json: { isAuthorized: false, reason: 'Dati mancanti' } };\n}\nif (chat.id !== 708137568) {\n  return { json: { isAuthorized: false, reason: 'Non autorizzato', chatId: chat.id, messageId: messageId } };\n}\n\nconst match = text.match(/^\\/(trade|lavoro|urgente|progetti)(?:\\s+|$)/i);\nlet tag = 'PERSONALE';\nlet cleanText = text;\nif (match) {\n  tag = match[1].toUpperCase();\n  cleanText = text.replace(match[0], '').trim();\n}\n\nconst now = new Date();\nconst formattedLine = `[${tag}] ${now.toISOString().slice(0, 10)} ${now.toTimeString().slice(0, 5)}: ${cleanText}`;\n\nreturn { json: { isAuthorized: true, formattedLine, chatId: chat.id, messageId: messageId } };"
      },
