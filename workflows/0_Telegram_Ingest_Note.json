        "jsCode": "const currentData = $input.first().json;\nconst guardData = $('Code: Guard & Parse').item.json;\nconst formattedLine = guardData.formattedLine;\n\nlet oldContent = '';\nif (currentData.data !== undefined) oldContent = String(currentData.data);\nelse if (currentData.body !== undefined) oldContent = String(currentData.body);\nelse if (currentData.text !== undefined) oldContent = String(currentData.text);\n\nconst newContent = oldContent.trim() ? oldContent.trim() + '\\n' + formattedLine : formattedLine;\nconst tagMatch = formattedLine.match(/\\[(.*?)\\]/);\nconst tag = tagMatch ? tagMatch[1] : 'PERSONALE';\n\nreturn { json: { newContent, chatId: guardData.chatId, messageId: guardData.messageId, tag: tag } };"
